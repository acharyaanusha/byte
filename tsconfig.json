{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "types": ["node", "vite/client"]
  },
  "include": ["server", "shared", "src", "tests", "scripts/*.d.mts", "vite.config.ts"]
}
